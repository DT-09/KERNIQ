# Shopify app credentials (Shopify Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.kerniq.com
SCOPES=read_products,read_inventory,read_orders
SHOPIFY_BILLING_TEST_MODE=false

# Managed PostgreSQL; use TLS in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kerniq?sslmode=require

# Runtime
NODE_ENV=production
PORT=3000
WORKER_CONCURRENCY=1
